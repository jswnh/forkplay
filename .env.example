# ==============================================================================
# FORKPLAY // ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.local` and fill in your credentials.
# Run `pnpm dev` to launch the local development server.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="ForkPlay"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Active Currency Code (e.g. PHP, USD, EUR) and Display Symbol (e.g. ₱, $, €)
NEXT_PUBLIC_CURRENCY="PHP"
NEXT_PUBLIC_CURRENCY_SYMBOL="₱"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Auth.js v5 / NextAuth)
# ------------------------------------------------------------------------------
# Base URL for auth callbacks
AUTH_URL="http://localhost:3000"

# Generate a 32-character secret in terminal: `openssl rand -hex 32`
AUTH_SECRET="your-32-character-auth-secret-here"

# Google OAuth Provider (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE (Neon / Supabase / Self-hosted)
# ------------------------------------------------------------------------------
# Pooled PostgreSQL connection string with SSL mode enabled
DATABASE_URL="postgresql://username:password@ep-your-database-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------------------------------------------
# API Key from https://resend.com/api-keys for account email verification & alerts
RESEND_API_KEY="re_123456789_your_resend_api_key_here"

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible)
# ------------------------------------------------------------------------------
# Obtain from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCESS_KEY_ID="your_cloudflare_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_cloudflare_r2_secret_access_key"
R2_BUCKET="your-bucket-name"

# Format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# Public R2 domain or Custom CDN URL (e.g. https://pub-xxxxxxxx.r2.dev or https://cdn.yourdomain.com)
R2_URL="https://pub-your-bucket-id.r2.dev"

# ------------------------------------------------------------------------------
# 6. ONLINE PAYMENT GATEWAY (Xendit)
# ------------------------------------------------------------------------------
# Obtain API Keys from Xendit Dashboard -> Settings -> API Keys
# Public API Key (Development/Production)
XENDIT_PUBLIC_KEY="xnd_public_development_..."

# Secret API Key (Used on server for creating invoices & checking status)
XENDIT_SECRET_KEY="xnd_development_..."