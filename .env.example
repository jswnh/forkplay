# Application Details
NEXT_PUBLIC_APP_NAME="ForkPlay"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js / NextAuth Configuration
# Generate a secret via terminal: openssl rand -hex 32
AUTH_URL="http://localhost:3000"
AUTH_SECRET="your-32-character-auth-secret-here"

# Google OAuth Provider (Google Cloud Console -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# PostgreSQL Database (Neon pooled connection string)
DATABASE_URL="postgresql://user:password@ep-pooler-name.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Resend API Key for Transactional Emails (resend.com)
RESEND_API_KEY="re_123456789_your_resend_api_key"